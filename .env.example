DATABASE_URL=postgresql://edubench:edubench@localhost:54329/edubench
# 선택 사항. 비워 두면 DATABASE_URL의 DB 이름에 _test를 붙인 별도 통합 테스트 DB를 사용합니다.
DATABASE_URL_TEST=
STORAGE_ROOT=./storage
MOCK_PROVIDERS=false
WORKER_BATCH_SIZE=8
PROVIDER_TIMEOUT_MS=90000
JUDGE_MAX_OUTPUT_TOKENS=8192
PDFTOPPM_PATH=pdftoppm
DOCUMENT_PARSE_BATCH_SIZE=4
DOCUMENT_PARSE_CONCURRENCY=3
EMBEDDING_BATCH_SIZE=50
EMBEDDING_CONCURRENCY=3
QUESTION_GENERATION_CONCURRENCY=4

GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_GENERATION_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=

UPSTAGE_API_KEY=
UPSTAGE_MODEL=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_DOCUMENT_PARSE_MODEL=document-parse

# 공개된 단일 관리형 endpoint가 없습니다. 계약 또는 자체 호스팅 OpenAI 호환 배포의 base URL을 입력합니다.
EXAONE_API_KEY=
EXAONE_MODEL=LGAI-EXAONE/K-EXAONE-236B-A23B
EXAONE_BASE_URL=https://api.friendli.ai/serverless/v1
EXAONE_PROTOCOL=openai-compatible
EXAONE_REQUEST_INTERVAL_MS=30000
EXAONE_RETRY_BASE_DELAY_MS=15000

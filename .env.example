# EduBench configuration. Copy to .env; every value here is optional for
# `docker compose up` (docker-compose.yml sets DATABASE_URL and STORAGE_ROOT).
#
# Provider API keys are NOT configured here. Each user enters their own keys on
# the in-app settings screen (/settings). Keys stay in the browser's
# localStorage and are sent only with requests that start provider work.

# Host ports used by docker compose
WEB_PORT=63000
DB_PORT=54329

# Local development outside Docker (npm run dev)
DATABASE_URL=postgresql://edubench:edubench@localhost:54329/edubench
# Optional. Empty means a separate test DB named after DATABASE_URL with _test.
DATABASE_URL_TEST=
STORAGE_ROOT=./storage

# DB pool wait, query, statement, lock and idle limits (ms). Values below 1ms
# or above 1 hour fall back to the defaults.
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Set to true when the app is served over HTTPS so the session cookie is Secure.
SESSION_COOKIE_SECURE=false
# false = create only the demo account (demo / demo1234), no demo research data.
SEED_DEMO_DATA=true
# false = do not run the background worker inside the web server.
EMBEDDED_WORKER=true
# true = every provider call returns a local placeholder response (no keys needed).
MOCK_PROVIDERS=false

WORKER_BATCH_SIZE=8
PDFTOPPM_PATH=pdftoppm
# Optional upper bound for a Judge call; the value used is recorded per call.
JUDGE_TIMEOUT_MS=180000
# Global wait after a benchmark 429 without retry timing (RPM/TPM/unclassified).
BENCHMARK_RATE_LIMIT_COOLDOWN_MS=120000
# Global wait after an RPD 429 without retry timing.
BENCHMARK_RATE_LIMIT_RPD_COOLDOWN_MS=900000

# Provider endpoints (not secrets). Model IDs and generation parameters live in
# the versioned research profiles on /settings.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# FriendliAI managed OpenAI-compatible endpoint for K-EXAONE.
EXAONE_BASE_URL=https://api.friendli.ai/serverless/v1
# Mi:dm has no public managed endpoint; set a contracted or self-hosted
# OpenAI-compatible base URL to enable it.
MIDM_BASE_URL=

DATABASE_URL=postgresql://edubench:edubench@localhost:54329/edubench
# DB 풀 대기, 쿼리, SQL 문장, 락, 유휴 연결의 상한(ms)입니다. 1ms 미만 또는
# 1시간 초과 값은 안전한 기본값으로 대체됩니다.
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
# 선택 사항. 비워 두면 DATABASE_URL의 DB 이름에 _test를 붙인 별도 통합 테스트 DB를 사용합니다.
DATABASE_URL_TEST=
STORAGE_ROOT=./storage
MOCK_PROVIDERS=false
WORKER_BATCH_SIZE=8
PDFTOPPM_PATH=pdftoppm
# 선택 사항. Judge 호출의 안전 상한이며 실제 사용값은 호출 스냅샷에 기록됩니다.
JUDGE_TIMEOUT_MS=180000
# 벤치마크 공급자가 재시도 시각을 주지 않은 RPM/TPM/미분류 429의 전역 대기시간(기본 2분)
BENCHMARK_RATE_LIMIT_COOLDOWN_MS=120000
# 재시도 시각을 주지 않은 RPD 429의 전역 대기시간(기본 15분)
BENCHMARK_RATE_LIMIT_RPD_COOLDOWN_MS=900000

# 모델 ID와 생성·파싱·임베딩 파라미터는 /settings의 버전형 연구
# 프로필에 들어 있습니다. 아래에서는 API 키와 OpenAI 모델 ID를 입력합니다.
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1

# FriendliAI의 K-EXAONE 관리형 OpenAI 호환 endpoint입니다.
EXAONE_API_KEY=
EXAONE_BASE_URL=https://api.friendli.ai/serverless/v1

DATABASE_URL=postgresql://edubench:edubench@localhost:54329/edubench
# 선택 사항. 비워 두면 DATABASE_URL의 DB 이름에 _test를 붙인 별도 통합 테스트 DB를 사용합니다.
DATABASE_URL_TEST=
STORAGE_ROOT=./storage
MOCK_PROVIDERS=false
WORKER_BATCH_SIZE=8
PROVIDER_TIMEOUT_MS=90000
PDFTOPPM_PATH=pdftoppm

GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_GENERATION_MODEL=
GEMINI_EMBEDDING_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

UPSTAGE_API_KEY=
UPSTAGE_MODEL=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_DOCUMENT_PARSE_MODEL=document-parse

# 공개된 단일 관리형 endpoint가 없습니다. 계약 또는 자체 호스팅 OpenAI 호환 배포의 base URL을 입력합니다.
EXAONE_API_KEY=
EXAONE_MODEL=
EXAONE_BASE_URL=
EXAONE_PROTOCOL=openai-compatible

# 공개된 단일 관리형 endpoint가 없습니다. 계약 또는 자체 호스팅 OpenAI 호환 배포의 base URL을 입력합니다.
MIDM_API_KEY=
MIDM_MODEL=
MIDM_BASE_URL=
MIDM_PROTOCOL=openai-compatible
